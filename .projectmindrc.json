{
  "projectRoot": ".",
  "databasePath": ".projectmind/pm-knowledge.db",
  "embeddingsDir": ".projectmind/embeddings",
  "maxDepth": 10,
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "dist-tests/**",
    ".git/**",
    ".kilo/**",
    "*.min.js",
    "*.map",
    "package-lock.json",
    "yarn.lock",
    "coverage/**",
    ".turbo/**"
  ],
  "llm": {
    "provider": "gemini",
    "model": "gemini-3.6-flash",
    "deepModel": "gemini-3.6-flash",
    "confidenceThreshold": 0.7,
    "maxCacheSize": 10000
  },
  "features": {
    "coherenceEngine": true,
    "debtTracker": true,
    "scaleManager": true,
    "memoryBridge": true
  },
  "kiloIntegration": {
    "autoScanOnSessionStart": true,
    "syncOnEdit": true,
    "coherenceCheckOnEdit": true,
    "preCommitGate": true,
    "genomeThreshold": 60,
    "maxHighDebt": 0,
    "maxMediumDebt": 10
  }
}