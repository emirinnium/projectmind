{
  "name": "projectmind-lcil",
  "displayName": "ProjectMind",
  "description": "AI-powered codebase intelligence: coherence, security, embeddings",
  "version": "0.10.0",
  "publisher": "emirinnium",
  "icon": "images/vscode-icon-128x128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/emirinnium/projectmind.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "code-intelligence",
    "coherence",
    "security",
    "embeddings",
    "mcp"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "images",
    "src",
    "snippets",
    "webview",
    "README.md",
    "tsconfig.json",
    "webpack.config.cjs"
  ],
  "contributes": {
    "commands": [
      {
        "command": "projectmind.scanProject",
        "title": "ProjectMind: Scan Project"
      },
      {
        "command": "projectmind.scanFile",
        "title": "ProjectMind: Scan Current File"
      },
      {
        "command": "projectmind.showReport",
        "title": "ProjectMind: Show Report"
      },
      {
        "command": "projectmind.copyReport",
        "title": "ProjectMind: Copy Report to Clipboard"
      },
      {
        "command": "projectmind.checkCoherence",
        "title": "ProjectMind: Check Coherence"
      },
      {
        "command": "projectmind.findSimilar",
        "title": "ProjectMind: Find Similar Code"
      },
      {
        "command": "projectmind.showImpact",
        "title": "ProjectMind: Show Impact Analysis"
      },
      {
        "command": "projectmind.openChat",
        "title": "ProjectMind: Open Chat Panel"
      },
      {
        "command": "projectmind.structuralSearch",
        "title": "ProjectMind: Structural Search by AST Pattern"
      },
      {
        "command": "projectmind.autoFix",
        "title": "ProjectMind: Auto-Fix Detected Issues"
      },
      {
        "command": "projectmind.refactorROI",
        "title": "ProjectMind: Show Refactoring ROI"
      },
      {
        "command": "projectmind.showGraph",
        "title": "ProjectMind: Show Dependency Graph"
      },
      {
        "command": "projectmind.openWebDashboard",
        "title": "ProjectMind: Open Web Dashboard"
      },
      {
        "command": "projectmind.toggleOfflineMode",
        "title": "ProjectMind: Toggle Offline Mode"
      },
      {
        "command": "projectmind.showMemory",
        "title": "ProjectMind: Show Stored Memories"
      },
      {
        "command": "projectmind.refreshTree",
        "title": "ProjectMind: Refresh File Tree"
      }
    ],
    "keybindings": [
      {
        "command": "projectmind.scanProject",
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "when": "editorTextFocus",
        "args": "/pm scan"
      },
      {
        "command": "projectmind.checkCoherence",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus",
        "args": "/pm coherence"
      },
      {
        "command": "projectmind.openChat",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "editorTextFocus",
        "args": "/pm chat"
      },
      {
        "command": "projectmind.showImpact",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorTextFocus",
        "args": "/pm impact"
      },
      {
        "command": "projectmind.showGraph",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "editorTextFocus",
        "args": "/pm graph"
      },
      {
        "command": "projectmind.showReport",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus",
        "args": "/pm report"
      }
    ],
    "snippets": [
      {
        "language": "typescript",
        "path": "./snippets/typescript.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/javascript.json"
      }
    ],
    "configuration": {
      "title": "ProjectMind",
      "properties": {
        "projectmind.autoScan": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan on startup"
        },
        "projectmind.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Scan file on save"
        },
        "projectmind.showInlineHints": {
          "type": "boolean",
          "default": true,
          "description": "Show inline coherence hints"
        },
        "projectmind.mcpServerPath": {
          "type": "string",
          "default": "projectmind",
          "description": "Path to projectmind MCP server"
        },
        "projectmind.embeddings.provider": {
          "type": "string",
          "enum": [
            "simple",
            "openai",
            "transformers"
          ],
          "default": "transformers",
          "description": "Embedding provider"
        },
        "projectmind.offline": {
          "type": "boolean",
          "default": false,
          "description": "Offline mode - no code sent to cloud LLM"
        },
        "projectmind.showGraph": {
          "type": "boolean",
          "default": true,
          "description": "Show dependency graph view"
        },
        "projectmind.chatProvider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "local",
            "none"
          ],
          "default": "local",
          "description": "Chat provider for the chat panel"
        },
        "projectmind.webDashboardUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "URL for the web dashboard"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "projectmindSidebar",
          "name": "ProjectMind",
          "when": "projectmind:activated"
        },
        {
          "id": "projectmindFiles",
          "name": "ProjectMind Files",
          "when": "projectmind:activated"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "projectmind",
          "title": "ProjectMind",
          "icon": "images/vscode-activity-icon.png"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "projectmind.scanProject",
          "when": "true"
        },
        {
          "command": "projectmind.scanFile",
          "when": "editorTextFocus"
        },
        {
          "command": "projectmind.showReport",
          "when": "true"
        },
        {
          "command": "projectmind.copyReport",
          "when": "true"
        },
        {
          "command": "projectmind.checkCoherence",
          "when": "editorTextFocus"
        },
        {
          "command": "projectmind.findSimilar",
          "when": "editorTextFocus"
        },
        {
          "command": "projectmind.showImpact",
          "when": "editorTextFocus"
        },
        {
          "command": "projectmind.openChat",
          "when": "true"
        },
        {
          "command": "projectmind.structuralSearch",
          "when": "editorTextFocus"
        },
        {
          "command": "projectmind.autoFix",
          "when": "editorTextFocus"
        },
        {
          "command": "projectmind.refactorROI",
          "when": "editorTextFocus"
        },
        {
          "command": "projectmind.showGraph",
          "when": "true"
        },
        {
          "command": "projectmind.openWebDashboard",
          "when": "true"
        },
        {
          "command": "projectmind.toggleOfflineMode",
          "when": "true"
        },
        {
          "command": "projectmind.showMemory",
          "when": "true"
        },
        {
          "command": "projectmind.refreshTree",
          "when": "true"
        }
      ],
      "editor/context": [
        {
          "command": "projectmind.scanFile",
          "when": "editorTextFocus",
          "group": "ProjectMind"
        },
        {
          "command": "projectmind.checkCoherence",
          "when": "editorTextFocus",
          "group": "ProjectMind"
        },
        {
          "command": "projectmind.showImpact",
          "when": "editorTextFocus",
          "group": "ProjectMind"
        },
        {
          "command": "projectmind.openChat",
          "when": "editorTextFocus",
          "group": "ProjectMind"
        },
        {
          "command": "projectmind.structuralSearch",
          "when": "editorTextFocus",
          "group": "ProjectMind"
        },
        {
          "command": "projectmind.autoFix",
          "when": "editorTextFocus",
          "group": "ProjectMind"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --config webpack.config.cjs",
    "watch": "webpack --watch --config webpack.config.cjs",
    "package": "webpack --mode production --devtool hidden-source-map --config webpack.config.cjs",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "ts-loader": "^9.5.0",
    "@vscode/test-cli": "^0.0.6",
    "@vscode/test-electron": "^2.3.0"
  }
}
