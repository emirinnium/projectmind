{
  "name": "@emirhanturker/projectmind",
  "version": "0.3.0",
  "description": "Living Codebase Intelligence Layer for AI Agents — persistent memory, real-time coherence, and Opus-level reasoning",
  "bin": {
    "projectmind": "./cli.mjs",
    "pm": "./cli.mjs"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./mcp-server": "./dist/mcp-server.js"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE",
    "assets/**/*"
  ],
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsc && node --no-deprecation dist/cli.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --fix --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node dist-tests/tests/integration.test.js",
    "test:vitest": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "start:mcp": "tsc && node --no-deprecation dist/mcp-server.js",
    "pm:scan": "node --no-deprecation dist/cli.js scan",
    "pm:genome": "node --no-deprecation dist/cli.js genome",
    "pm:debt": "node --no-deprecation dist/cli.js debt",
    "pm:check": "node --no-deprecation dist/cli.js check",
    "pm:context": "node --no-deprecation dist/cli.js context",
    "pm:scale": "node --no-deprecation dist/cli.js scale",
    "pm:session": "node --no-deprecation dist/cli.js session",
    "pm:memory": "node dist/cli.js memory",
    "pm:resolve": "node dist/cli.js resolve",
    "pm:report": "node dist/cli.js report",
    "pm:ci": "npm run build && npm run pm:scan && npm run pm:genome && npm run pm:debt",
    "ci": "npm run lint && npm run typecheck && npm run test:vitest && npm run test:coverage",
    "prepare": "npm run build"
  },
  "keywords": [
    "ai",
    "code-intelligence",
    "coherence",
    "agent",
    "mcp",
    "codebase-analysis"
  ],
  "author": "emirinnium",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emirinnium/projectmind.git"
  },
  "bugs": {
    "url": "https://github.com/emirinnium/projectmind/issues"
  },
  "homepage": "https://github.com/emirinnium/projectmind#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.0",
    "@xenova/transformers": "^2.17.2",
    "commander": "^12.1.0",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "onnxruntime-node": "^1.27.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "^5.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "tree-sitter-cpp": {
      "tree-sitter": "^0.25.1"
    },
    "adm-zip": "^0.6.0",
    "protobufjs": "^8.7.2",
    "sharp": "^0.35.3"
  }
}
