{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "projectmind": {
      "type": "local",
      "command": ["node", "dist/mcp-server.js"],
      "cwd": ".",
      "environment": {
        "NODE_ENV": "production"
      },
      "enabled": true,
      "timeout": 30000
    }
  },
  "provider": {
    "openai": {
      "options": {
        "apiKey": "YOUR_GEMINI_API_KEY_HERE",
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai"
      },
      "models": {
        "gemini-2.5-flash": { "name": "Gemini 2.5 Flash" }
      }
    },
    "groq": {
      "options": {
        "apiKey": "YOUR_GROQ_API_KEY_HERE"
      },
      "models": {
        "llama-3.3-70b-versatile": { "name": "Llama 3.3 70B Versatile" }
      }
    },
    "tokenrouter": {
      "options": {
        "apiKey": "sk-RtytAH4o4HoK41B0LcCQTBz5gwUG8uzXypjO9L9AQAbrLhgv",
        "baseURL": "https://api.tokenrouter.com/v1"
      },
      "models": {
        "qwen/qwen3.8-max-free": { "name": "Qwen 3.8 Max Free" }
      }
    }
  },
  "permission": {
    "projectmind_*": "allow",
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow"
  },
  "model": "tokenrouter/qwen/qwen3.8-max-free",
  "small_model": "groq/llama-3.3-70b-versatile",
  "instructions": [
    ".kilo/instructions/projectmind-auto.md"
  ],
  "autoupdate": "notify",
  "agent": {
    "build": {
      "steps": 500
    },
    "plan": {
      "steps": 500
    },
    "general": {
      "steps": 500
    },
    "explore": {
      "steps": 500
    },
    "projectmind": {
      "steps": 500
    },
    "automation": {
      "mode": "all",
      "model": "mistral/mistral-small-2603",
      "steps": 600,
      "permission": {
        "task": {
          "*": "allow",
          "project-analyzer": "allow",
          "code-planner": "allow",
          "coder": "allow"
        }
      }
    },
    "project-analyzer": {
      "mode": "subagent",
      "model": "tokenrouter/qwen/qwen3.8-max-free",
      "steps": 60,
      "permission": {
        "edit": "deny",
        "write": "deny"
      }
    },
    "code-planner": {
      "mode": "subagent",
      "model": "mistral/mistral-small-2603",
      "steps": 60,
      "permission": {
        "edit": "deny",
        "write": "deny"
      }
    },
    "coder": {
      "mode": "subagent",
      "model": "openrouter/xiaomi/mimo-v2.5-pro",
      "steps": 300
    }
  }
}