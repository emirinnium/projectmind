{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "orchestrator",
  "subagent_depth": 2,

  "mcp": {
    "projectmind": {
      "type": "local",
      "command": ["node", "dist/mcp-server.js"],
      "cwd": ".",
      "environment": {
        "NODE_ENV": "production"
      },
      "enabled": true,
      "timeout": 120000
    }
  },

  "provider": {
    "opencode": {
      "options": {
        "timeout": 240000,
        "chunkTimeout": 90000
      }
    },
    "nvidia": {
      "options": {
        "timeout": 240000,
        "chunkTimeout": 90000
      }
    },
    "kilo": {
      "options": {
        "timeout": 240000,
        "chunkTimeout": 90000
      }
    },
    "mistral": {
      "options": {
        "timeout": 240000,
        "chunkTimeout": 90000
      }
    }
  },

  "model": "kilo/nvidia/nemotron-3-super-120b-a12b:free",
  "small_model": "kilo/nvidia/nemotron-3.5-lightning:free",

  "instructions": [],
  "autoupdate": "notify",

  "permission": {
    "projectmind_*": "allow",
    "read": "allow",
    "edit": "allow",
    "write": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "allow",
    "question": "deny",
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny"
    }
  }
}